(function () {
  const ALLOWED_SOURCES = ["samsung_tile", "samsung_browser_tile","vevo_browser","safari_browser"];
  const params = new URLSearchParams(window.location.search);
  const utmSource = params.get("utm_source");

  if (!ALLOWED_SOURCES.includes(utmSource)) return;

  // Single delegated click listener for all links
  document.addEventListener("click", (event) => {

    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey) return;

    const link = event.target.closest("a");
    if (!link) return;

    const href = link.getAttribute("href");
    if (!href || href.startsWith("#") || (/^https?:\/\//.test(href) && !href.startsWith(window.location.origin))) {
      return;
    }

    try {
      const url = new URL(link.href, window.location.origin);

      if (url.searchParams.get("utm_source") === utmSource) return;

      url.searchParams.set("utm_source", utmSource);
      link.href = url.toString();
    } catch (e) {
      // ignore invalid URLs
    }

  });

  function getQueryParam(param) {
    const urlParams = new URLSearchParams(window.location.search);
    return urlParams.get(param);
  }

  var utm_source = getQueryParam('utm_source');
  if (utm_source && ALLOWED_SOURCES.includes(utm_source)) {
    googletag.cmd.push(function() {
      googletag.pubads().setTargeting('utm_source', utm_source);
    });
  }
})();

