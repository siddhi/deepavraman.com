entries.author.value+
'</span>'}
entryId=entryId.replace("/","");eventEntryHtml='<li class="time-list cue-live-event live-snippet-border blog-item" data-item="'+eventhappening+'"  data-event-publish-date="'+entries.publishDate+'" data-event-uri="'+articleUrl+'/liveEvent/entry/'+entryId+'" data-event-id="'+entryId+'" id="'+entryId+'" itemprop="liveBlogUpdate" itemscope itemtype="https://schema.org/BlogPosting">'+
