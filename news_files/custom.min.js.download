function openShareLink(pLink){var popUp=window.open(pLink,'popupwindow','scrollbars=yes,width=740,height=400');popUp.focus();$(".share-list").hide();return false;}
function copytext(a){if(navigator.clipboard){navigator.clipboard.writeText(a).then(function(){$('.copy-link').text("Link copied");},function(err){});}
else{console.log("clipboard not available...")}}
function showLoader(selector){$(selector).show()
imglazyload(selector+".th-loader");}
function hideLoader(selector){$(selector).hide()}
function get_context(interval,context){return interval>1?context+"s"+" ago":context+" ago";}
function timeSince(date){var seconds=Math.floor((new Date()-date)/1000);var interval=seconds/31536000;var floorinterval=Math.floor(interval)
if(interval>1){return floorinterval+get_context(floorinterval," year");}
interval=seconds/2592000;floorinterval=Math.floor(interval)
if(interval>1){return floorinterval+get_context(floorinterval," month");}
interval=seconds/86400;floorinterval=Math.floor(interval)
if(interval>1){return floorinterval+get_context(floorinterval," day");}
interval=seconds/3600;floorinterval=Math.floor(interval)
if(interval>1){return floorinterval+get_context(floorinterval," hour");}
interval=seconds/60;floorinterval=Math.floor(interval)
if(interval>1){return floorinterval+get_context(floorinterval," min");}
if(seconds<0){seconds=1;}
return Math.floor(seconds)+" seconds ago";}
