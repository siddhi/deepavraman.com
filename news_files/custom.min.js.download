function viewPollResults(url,id){fetch(url).then(function(response){return response.json();}).then(function(result){PollResult(result,id)}).catch(function(error){console.log('error',error)});}
function PollResult(response){const options=response.options||[];const id=response.id;if(!options.length){console.warn("No poll options found");return;}
let totalVotes=0;options.forEach(opt=>{totalVotes+=Number(opt.vote||0);});let resultsHtml='';options.forEach(opt=>{const votes=Number(opt.vote||0);const percentage=totalVotes?((votes/totalVotes)*100).toFixed(0):0;resultsHtml+=`<li><div class="poll-item">${opt.value}</div><div class="result-bar"><div class="count">${votes}(${percentage}%)</div><div class="progress-bar"><div class="progress"style="width:${percentage}%;"></div></div></div></li>`;});const html=`<ul class="poll-list">${resultsHtml}</ul><div class="actions"><div class="total">TOTAL NO OF VOTES<span>${totalVotes}</span></div></div>`;const pollBox=document.querySelector(".poll-box");if(pollBox)pollBox.classList.add("poll-closed");const pollDisplay=document.querySelector("#polldisplay"+id);if(pollDisplay)pollDisplay.innerHTML=html;}
function showpollresults(pollId,pollHash){const id=pollId;if(readCookie("mentometer"+id)==id+"M"){const hash=pollHash;const url=["/_poll",id,hash].join('/');viewPollResults(url,id);}}
function skippollresults(pollId,pollHash){const id=pollId;const hash=pollHash;const url=["/_poll",id,hash].join('/');viewPollResults(url,id);}
function addOrRemoveFavourites(articleId="",action="add"){const userDetails=window.tp.pianoId.getUser()
const userId=userDetails?userDetails.uid:null;const favEndPoint=window._thg_config.ufenpoint;const pubId=window._thg_config.ufsiteId
if(userId===null||articleId==""||favEndPoint==""||pubId=="")return null
return fetch(favEndPoint+"favourites",{method:action==="add"?'POST':'DELETE',headers:{'Content-Type':'application/json','x-client-auth':window.tp.pianoId.getToken()},body:JSON.stringify({"userId":userId,"articleId":articleId,"pub":pubId}),}).then(res=>res.json()).catch((err)=>{console.error(err)
return null})}
function getFavouritesArticles(){const userDetails=window.tp.pianoId.getUser()
const userId=userDetails?userDetails.uid:null
const favEndPoint=window._thg_config.ufenpoint;const pubId=window._thg_config.ufsiteId
if(userId===null||favEndPoint==""||pubId=="")return null
return fetch(favEndPoint+"favourites?userId="+userId+"&pub="+pubId,{method:'GET',headers:{'Content-Type':'application/json','x-client-auth':window.tp.pianoId.getToken()}}).then(res=>res.json()).catch((err)=>{console.error(err)
return null})}
