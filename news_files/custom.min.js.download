var readLater=document.querySelectorAll(".read-later-btn");for(var i=0;i<readLater.length;++i){readLater[i].style.display="block";}}
else{var readLater=document.querySelectorAll(".read-later-btn");for(var i=0;i<readLater.length;++i){readLater[i].style.display="block";}}
triggerBookmark();});}else{var readLater=document.querySelectorAll(".read-later-btn");for(var i=0;i<readLater.length;++i){readLater[i].style.display="block";}}}}]);},500);function updateRelativeTime(){$('.time span[data-publish-date]').each(function(){var time=$(this).data('publish-date');if(time){$(this).html(moment(time).fromNow());}});$('.time[data-publish-date]').each(function(){var time=$(this).data('publish-date');if(time){$(this).html(moment(time).fromNow());}});}
function formatCustomDate(dateString){var lastModifiedDate=new Date(dateString);var month=lastModifiedDate.toLocaleString('en-US',{month:'long'});var day=lastModifiedDate.getDate().toString().padStart(2,'0');var year=lastModifiedDate.getFullYear();var hour=lastModifiedDate.getHours().toString().padStart(2,'0');var minute=lastModifiedDate.getMinutes().toString().padStart(2,'0');var formattedDate=`${month}&nbsp;${day},&nbsp;${year}&nbsp;${hour}:${minute}`;return formattedDate;}
function createEventEntry(entries,entryId,articleUrl,entryType){var eventEntryHtml='';var entryUrl=entries.self;var state=entries.state;var payload=entries.payload;var options={month:'long',day:'numeric',year:'numeric',hour:"2-digit",minute:"2-digit",hour12:false};;if(typeof payload!="undefined"){var keyevent=payload.find(element=>element.name=="milestone"&&element.value==true);var title=payload.find(element=>element.name=="title");var body=payload.find(element=>element.name=="body");var eventhappeninglist=payload.find(element=>element.name=="happening");var bodytext=(typeof body.value!=='undefined'?body.value:'');var eventhappening=((typeof eventhappeninglist!=='undefined'&&typeof eventhappeninglist.value!=='undefined')?eventhappeninglist.value:'');var iframefinder=bodytext.match(/([\w\s]*)(?:<script.*?\/script>)/);var lastModifiedDate=new Date(entries.publishDate);if(typeof iframefinder=="object"&&iframefinder!=null&&iframefinder.length>0){var iframereplacer=iframefinder.find(element=>element.includes("iframeResizer.min.js"));if(typeof iframereplacer!="undefined"){bodytext=bodytext.replace(iframereplacer,"<script> require(['iframeResizer']);</script>")}}
