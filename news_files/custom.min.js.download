'<meta itemprop="dateModified" content="'+entries.lastModifiedDate+'">'+
'<meta itemprop="url" content="'+articleUrl+'#'+entryId+'"/>'+
'<div class="time" data-publish-date="'+entries.publishDate+'">'+formatCustomDate(lastModifiedDate)+'</div>'+
entryTypeHtml+
'<div class="title" itemprop="headline">'+
(typeof title.value!=='undefined'?title.value:'')+
'</div>'+
'<div class="sub-text" itemprop="articleBody">'+
bodytext+
authorHtml+
'</div>'+
'</div>'+
'</li>';}
return eventEntryHtml;}
function startSSEListener(articleUrl,sseUri,sseFilter,sseLastEventId,entryType){require(['moment'],function(moment){if(sseUri&&sseUri.charAt(sseUri.length-1)!="/"){sseUri=sseUri+"/";}
sseUri=`${sseUri}?filter=${sseFilter}`;if(sseLastEventId){sseUri=`${sseUri}&last-event-id=${sseLastEventId}`;}
var eventSource=new EventSource(sseUri);eventSource.addEventListener('changelog',(e)=>{if(e.data&&e.data.indexOf(sseFilter)!==-1){var changes=JSON.parse(e.data);for(var i=0;i<changes.entries.length;i++){var entryUrl=changes.entries[i].self;var state=changes.entries[i].state;var payload=changes.entries[i].payload;var entryId=entryUrl.substr(entryUrl.lastIndexOf("/"),entryUrl.length);var entryWaiterUrl=`${articleUrl}/liveEvent/entry${entryId}`;var sticky=changes.entries[i].sticky;var lastModifiedDate=changes.entries[i].lastModifiedDate;var publishDate=changes.entries[i].publishDate;if(state&&state==='deleted'){$(`#entryList li[data-event-uri='${entryWaiterUrl}'],div[data-event-uri='${entryWaiterUrl}']`).remove();}else if(sticky){$(`#entryList li[data-event-uri='${entryWaiterUrl}'],div[data-event-uri='${entryWaiterUrl}']`).remove();var keyevent=payload.find(element=>element.name=="milestone"&&element.value==true);var title=payload.find(element=>element.name=="title");var body=payload.find(element=>element.name=="body");var newentryId=entryId.replace("/","");if(typeof title==='object'&&typeof title.value!=='undefined'){var variable='<div class="stickyentry" data-event-publish-date="'+publishDate+'"'+
'data-event-uri="'+entryWaiterUrl+'"'+
'data-event-sticky="sticky" itemprop="liveBlogUpdate"'+
'itemscope itemtype="https://schema.org/BlogPosting">'+
'<div class="cue-live-event fact-box">'+
'<meta itemprop="datePublished" content="'+publishDate+'" />'+
'<meta itemprop="dateModified" content="'+lastModifiedDate+'">'+
'<meta itemprop="url" content="#'+newentryId+'" />'+
'<h5 itemprop="headline" class="sub-title">'+
title.value+
'</h5>'+
'<div itemprop="articleBody" class="fact-element">'+
body.value+
'</div>'+
'</div>'+
'</div>';const existingpin=$(`#pinEvent`).find(`div[data-event-uri='${entryWaiterUrl}']`);if(existingpin.length){existingpin.replaceWith(variable);}else{$("#pinEvent").prepend(variable);}}}
else{$(`#pinEvent div[data-event-uri='${entryWaiterUrl}'`).remove();$(`#key-updates-list li[data-event-uri='${entryWaiterUrl}'`).remove();var keyevent=payload.find(element=>element.name=="milestone"&&element.value==true);if(typeof keyevent==='object'&&keyevent.value===true){var newentryId=entryId.replace("/","");if(document.querySelector("#cue-live-keyevents-update")!=null){var title=payload.find(element=>element.name=="title");if(typeof title==='object'&&typeof title.value!=='undefined'){var variable='<li data-event-uri="'+entryWaiterUrl+'" data-event-publish-date="'+publishDate+'">'+
'<a href="#'+newentryId+'">'+
title.value+
'</a></li>';const existingkeyevents=$("#liveentryListskeyevent .key-updates-list").find(`li[data-event-uri='${entryWaiterUrl}']`);if(existingkeyevents.length){existingkeyevents.replaceWith(variable);}else{$("#liveentryListskeyevent .key-updates-list").prepend(variable);}}}
else{var title=payload.find(element=>element.name=="title");if(typeof title==='object'&&typeof title.value!=='undefined'){var variable='<div id="cue-live-keyevents-update">'+
'<h5 class="red-font">Key Updates</h5>'+
'<ul class="key-updates-list" id="key-updates-list"><li  data-event-uri="'+entryWaiterUrl+'" data-event-publish-date="'+publishDate+'">'+
'<a href="#'+newentryId+'">'+
title.value+
'</a></ul></li></div>';$("#liveentryListskeyevent").html(variable);}}
$('#key-updates-list').children().sort(function(a,b){var entryApubDate=moment($(a).data('eventPublishDate'));var entryBpubDate=moment($(b).data('eventPublishDate'));var stickyA=$(a).data('eventSticky');var stickyB=$(b).data('eventSticky');if(stickyA){return-1;}
if(stickyB){return 1;}
return entryApubDate.isBefore(entryBpubDate)?1:-1;}).appendTo('#key-updates-list');}
const newEntry=createEventEntry(changes.entries[i],entryId,articleUrl,entryType);const existingEntry=$(`#entryList li[data-event-uri='${entryWaiterUrl}']`);if(existingEntry.length){existingEntry.replaceWith(newEntry);}else{const olderEntry=$("#entryList li").filter(function(){return new Date($(this).attr("data-event-publish-date"))<new Date(publishDate);}).first();if(olderEntry.length){olderEntry.before(newEntry);}else{$("#entryList").append(newEntry);}
}
const selectElement=document.getElementById('myselection');const entryList=document.getElementById('entryList');const listItems=entryList?.getElementsByClassName('time-list');const selectedValue=$('button.blog-filter.active').attr('data-target');for(let i=0;i<listItems.length;i++){const item=listItems[i];const happening=item.getAttribute('data-item');if(happening==selectedValue||selectedValue==="all"||selectedValue==undefined){item.style.display="block"}else{item.style.display="none"}}
let happen=[];for(let i=0;i<listItems.length;i++){const item=listItems[i];const happening=item.getAttribute('data-item');happen.push(happening);}
let uniqueArray=[...new Set(happen)];const filtereduniquearr=uniqueArray.filter(item=>item!==""&&item!==null);if(filtereduniquearr.length>0){let optionsHTML='<button class="blog-filter active" data-target="all"><span class="icon"><img src="/theme/images/th-online/live-event/blog-filter-all.svg" data-src-template="/theme/images/th-online/live-event/blog-filter-all.svg" class=""></span><span class="text">All</span></button>';uniqueArray.forEach(value=>{if(value!=''&&value!=null){if(value.includes("-")==true){let replaval=value.replace("-"," ");optionsHTML+=`<button class="blog-filter"data-target="${value}"><span class="icon"><img src="/theme/images/th-online/live-event/blog-filter-${value}.svg"data-src-template="/theme/images/th-online/live-event/blog-filter-${value}.svg"class=""></span><span class="text">${value.replace("-"," ")}</span></button>`;}else{optionsHTML+=`<button class="blog-filter"data-target="${value}"><span class="icon"><img src="/theme/images/th-online/live-event/blog-filter-${value}.svg"data-src-template="/theme/images/th-online/live-event/blog-filter-${value}.svg"class=""></span><span class="text">${value.replace("-"," ")}</span></button>`;}}});selectElement.innerHTML=optionsHTML;}
$(".live-blog-filters .blog-filter").click(function(e){e.preventDefault();var target=$(this).data("target");var blogTop=$('.article-live-blog').offset().top-150;window.scrollTo({top:blogTop,behavior:'instant'});setTimeout(function(){$(".live-blog-filters .blog-filter").removeClass("active");$(".live-blog-filters .blog-filter[data-target='"+target+"']").addClass("active");if(target==="all"){$(".article-live-blog .blog-item").show();$(".time-list .dfp-ad").css("display","block");}else{$(".article-live-blog .blog-item").hide();$(".article-live-blog .blog-item[data-item='"+target+"']").show();$(".time-list .dfp-ad").css("display","none");}},50);});}}}},false);eventSource.addEventListener('state',()=>{const selectElement=document.getElementById('myselection');const entryList=document.getElementById('entryList');const listItems=entryList?.getElementsByClassName('time-list');const selectedValue=$('button.blog-filter.active').attr('data-target');let happen=[];for(let i=0;i<listItems.length;i++){const item=listItems[i];const happening=item.getAttribute('data-item');happen.push(happening);}
let uniqueArray=[...new Set(happen)];const filtereduniquearr=uniqueArray.filter(item=>item!==""&&item!==null);if(filtereduniquearr.length>0){let optionsHTML=`<button class="blog-filter active"data-target="all"><span class="icon"><img src="/theme/images/th-online/live-event/blog-filter-all.svg"data-src-template="/theme/images/th-online/live-event/blog-filter-all.svg"></span><span class="text">All</span></button>`;uniqueArray.forEach(value=>{if(value!==''&&value!==null){let replaval=value.includes("-")?value.replace("-"," "):value;optionsHTML+=`<button class="blog-filter"data-target="${value}"><span class="icon"><img src="/theme/images/th-online/live-event/blog-filter-${value}.svg"data-src-template="/theme/images/th-online/live-event/blog-filter-${value}.svg"></span><span class="text">${replaval}</span></button>`;}});selectElement.innerHTML=optionsHTML;}
$(".live-blog-filters .blog-filter").click(function(e){e.preventDefault();var target=$(this).data("target");var blogTop=$('.article-live-blog').offset().top-150;window.scrollTo({top:blogTop,behavior:'instant'});setTimeout(function(){$(".live-blog-filters .blog-filter").removeClass("active");$(".live-blog-filters .blog-filter[data-target='"+target+"']").addClass("active");if(target==="all"){$(".article-live-blog .blog-item").show();$(".time-list .dfp-ad").css("display","block");}else{$(".article-live-blog .blog-item").hide();$(".article-live-blog .blog-item[data-item='"+target+"']").show();$(".time-list .dfp-ad").css("display","none");}},50);});},false);eventSource.addEventListener('error',(e)=>{if(e.readyState==EventSource.CLOSED){console.debug("Connection is closed");}},false);});}
function isTouchDevice(){return'ontouchstart'in window||navigator.maxTouchPoints>0;}
if(typeof liveEntrySSE=="function"){liveEntrySSE();}
if(pageType()!="art"){require(["jquery"],function($){if($(window).width()>1200){var totalWidth=-3.8;var activeLinkWidth=-3.8;$(".link-list li").each(function(){if($(this).hasClass("active")){activeLinkWidth=totalWidth;}
totalWidth=totalWidth+$(this).width()+3.8;});var link_scroll_length=totalWidth-1150;var scroll_length=0;var total_fold=parseInt((totalWidth-1150)/1150);var remaining_length=(totalWidth-1150)%1150;var no_of_fold=total_fold;if(totalWidth>1276){$(".scroll-arrow-btn.right").show();}
if(activeLinkWidth<1150){scroll_length=0;no_of_fold=total_fold;}
else if((totalWidth-activeLinkWidth)<1150){scroll_length=link_scroll_length;no_of_fold=0;$(".link-list").scrollLeft(scroll_length);$(".scroll-arrow-btn.left").show();$(".scroll-arrow-btn.right").hide();}
else if('activeLinkWidth < 1150'&&'(totalWidth - activeLinkWidth) > 1150'){no_of_fold=parseInt(activeLinkWidth/1150);scroll_length=(no_of_fold*1150);no_of_fold--;$(".link-list").scrollLeft(scroll_length);$(".scroll-arrow-btn.left").show();$(".scroll-arrow-btn.right").show();}}
$(".scroll-arrow-btn.right").click(function(){$(".scroll-arrow-btn.left").show();if(no_of_fold>0){scroll_length=scroll_length+1150;if(scroll_length==link_scroll_length){$(".scroll-arrow-btn.right").hide();}
$(".link-list").scrollLeft(scroll_length);no_of_fold--;return 0;}
scroll_length=scroll_length+remaining_length;$(".link-list").scrollLeft(scroll_length);$(".scroll-arrow-btn.right").hide();return false;});$(".scroll-arrow-btn.left").click(function(){$(".scroll-arrow-btn.right").show();if(no_of_fold<total_fold){scroll_length=scroll_length-1150;if(scroll_length<remaining_length){$(".scroll-arrow-btn.left").hide();}
$(".link-list").scrollLeft(scroll_length);no_of_fold++;return 0;}
scroll_length=scroll_length-remaining_length;$(".link-list").scrollLeft(scroll_length);$(".scroll-arrow-btn.left").hide();return false;});});}
if(Videopage()=="true"){const currentPage=window.location.pathname.split("/").pop();const navLinks=document.querySelectorAll(".page-nav-menu .link");navLinks.forEach(link=>{const linkPage=link.getAttribute("href");if(linkPage===currentPage){link.classList.add("active");}});}