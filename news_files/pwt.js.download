//Custom code by publisher starts
PWT.HookForPrebidRequestBids = function (adUnits) {
  adUnits.forEach(function (au) {

    
    if ([
      '/22390678/TH_Mweb_Anchor_HP',
      '/22390678/TH_Mweb_Anchor_AT',
      '/22390678/TH_MWeb_Anchor_Topic'
    ].includes(au.owAdUnitId)) {
      au.mediaTypes = {
        banner: {
          sizes: [[320, 50], [320, 100], [300, 50], [300, 100]]
        }
      };
    }

    
    if ([
      '/22390678/TH_Desktop_Anchor_HP',
      '/22390678/TH_Desktop_Anchor_AT',
      '/22390678/TH_Desktop_Anchor_Topic'
    ].includes(au.owAdUnitId)) {
      au.mediaTypes = {
        banner: {
          sizes: [[728, 90], [950, 90], [960, 90], [970, 90], [980, 90]]
        }
      };
    }

  });
};
//Custom code by publisher ends
let testingFledgeTopics=1;